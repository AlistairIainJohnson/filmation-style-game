    },
    "sfx_appear_sparkles": {
      "streams": ["res://assets/audio/sfx/appear_sparkles.wav"],
      "bus": "RoomFX",
      "volume_db": -4.5,
      "pitch_min": 0.97,
      "pitch_max": 1.03
    },
    "sfx_death_sparkles": {
      "streams": ["res://assets/audio/sfx/death_sting.wav"],
      "bus": "RoomFX",
