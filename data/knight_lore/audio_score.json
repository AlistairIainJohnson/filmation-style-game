{
  "metadata": {
    "description": "Orchestral score cue manifest for Knight Lore 3D. Streams are rendered offline from de-interleaved Knight Lore motifs using FluidSynth + GeneralUser GS."
  },
  "mix": {
    "music_bus_db": -2.0,
    "gameplay_music_db": -10.5
  },
